        }
       ],
       "maxItems": 12
      },
      "defaultValue": [
       {
        "title": "Feature one",
        "description": "Sample description. Replace with your own."
       },
       {
        "title": "Feature two",
        "description": "Sample description. Replace with your own."
       },
       {
        "title": "Feature three",
        "description": "Sample description. Replace with your own."
       }
      ]
     },
     {
      "slug": "variant",
      "label": "Layout",
      "type": "select",
      "validation": {
       "options": [
        "Mixed-size tiles",
        "Cards",
        "Simple list"
       ]
      },
      "defaultValue": "Mixed-size tiles"
     },
     {
      "slug": "columns",
      "label": "Columns on desktop",
