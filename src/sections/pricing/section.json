{
 "blockType": {
  "slug": "pricing",
  "label": "Pricing",
  "category": "Products and prices",
  "description": "Packages side by side, one highlighted.",
  "currentVersion": 1,
  "versions": [
   {
    "version": 1,
    "fields": [
     {
      "slug": "heading",
