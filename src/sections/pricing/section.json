      "defaultValue": false
     },
     {
      "slug": "plans",
      "label": "Plans",
      "type": "repeater",
      "validation": {
       "subFields": [
        {
         "slug": "name",
         "label": "Plan name",
         "type": "string",
         "required": true
        },
        {
         "slug": "price",
         "label": "Price",
         "type": "string"
        },
        {
         "slug": "period",
         "label": "Period (e.g. /month + GST)",
         "type": "string"
        },
        {
         "slug": "description",
         "label": "Description",
         "type": "text"
        },
        {
         "slug": "includes",
         "label": "What's included (one per line)",
         "type": "text"
        },
        {
         "slug": "featured",
         "label": "Highlight this plan",
         "type": "boolean"
        },
        {
         "slug": "cta_label",
         "label": "Button label",
         "type": "string"
        },
        {
         "slug": "cta_url",
         "label": "Button link",
         "type": "url"
        }
       ],
       "maxItems": 4
      },
      "defaultValue": [
       {
        "name": "Sample plan",
        "price": "$00",
        "period": "per visit",
        "description": "Sample description. Replace with your own.",
        "includes": "Sample item\nSample item"
       },
       {
        "name": "Another sample plan",
        "price": "$00",
        "period": "per visit",
        "description": "Sample description. Replace with your own.",
        "includes": "Sample item\nSample item",
        "featured": true
       }
      ]
     },
     {
      "slug": "variant",
      "label": "Layout",
      "type": "select",
      "validation": {
       "options": [
        "Cards",
        "Compact list"
       ]
      },
      "defaultValue": "Cards"
     },
     {
      "slug": "background",
      "label": "Background colour",
      "type": "select",
      "defaultValue": "Plain",
      "validation": {
       "options": [
        "Plain",
        "Soft tint",
        "Dark",
        "Brand colour"
       ]
      }
     },
     {
      "slug": "anchor_id",
      "label": "Menu link name (optional). Lowercase, e.g. faq. A menu item linking to #faq jumps here.",
      "type": "string",
      "validation": {
       "pattern": "^(?:$|[a-z][a-z0-9_-]*)$"
      }
     }
    ]
   }
  ]
 },
 "optionValues": {
  "variant": {
