{
 "blockType": {
  "slug": "hero",
  "label": "Hero",
  "category": "Start of page",
  "description": "Big headline, buttons and optional photo.",
  "currentVersion": 1,
  "versions": [
   {
    "version": 1,
    "fields": [
     {
      "slug": "headline",
      "label": "Headline (the big text)",
      "type": "string",
      "required": true,
      "defaultValue": "Your headline here"
     },
     {
      "slug": "kicker",
      "label": "Small label above the heading (optional)",
      "type": "string"
     },
     {
      "slug": "headline_accent",
      "label": "Highlighted words at the end of the headline (optional)",
      "type": "string"
     },
     {
      "slug": "body",
      "label": "Intro text (optional)",
      "type": "text",
      "defaultValue": "A sentence or two about what you offer. Replace this sample text."
     },
     {
      "slug": "primary_label",
      "label": "Main button text",
      "type": "string",
      "defaultValue": "Get in touch"
     },
     {
      "slug": "secondary_label",
      "label": "Second button text (optional)",
      "type": "string"
     },
     {
      "slug": "ticker",
      "label": "Short highlights under the buttons, one per line (optional)",
      "type": "text"
     },
     {
      "slug": "image",
      "label": "Photo (optional)",
      "type": "image"
     },
     {
      "slug": "focal_x",
      "label": "Photo focus, left to right (0–100). Move this if faces get cut off.",
      "type": "integer",
      "validation": {
       "min": 0,
       "max": 100
      },
      "defaultValue": 50
     },
     {
      "slug": "focal_y",
      "label": "Photo focus, top to bottom (0–100). Lower numbers keep heads in frame.",
      "type": "integer",
      "validation": {
       "min": 0,
       "max": 100
      },
      "defaultValue": 35
     },
     {
      "slug": "effect",
      "label": "Movement",
      "type": "select",
      "validation": {
       "options": [
        "No motion",
        "Parallax (photo drifts as you scroll)",
        "Slow zoom on the photo",
        "Animated dots (no photo needed)"
       ]
      },
      "defaultValue": "Parallax (photo drifts as you scroll)"
     },
     {
      "slug": "variant",
      "label": "Layout",
      "type": "select",
      "validation": {
       "options": [
        "Text beside the photo",
        "Centred text",
        "Photo fills the background"
       ]
      },
      "defaultValue": "Text beside the photo"
     },
     {
      "slug": "height",
      "label": "Height",
      "type": "select",
      "validation": {
       "options": [
        "Full screen",
        "Tall",
        "Just fit the text"
       ]
      },
      "defaultValue": "Full screen"
     },
     {
      "slug": "background",
      "label": "Background colour",
      "type": "select",
      "defaultValue": "Plain",
      "validation": {
       "options": [
        "Plain",
        "Soft tint",
        "Dark",
        "Brand colour"
       ]
      }
     },
     {
      "slug": "primary_url",
      "label": "Main button link (a page like /contact, #section, or https://…)",
      "type": "string",
      "validation": {
       "pattern": "^(?:$|(?:https?://|mailto:|tel:|/(?!/)|#).+)$"
      },
      "defaultValue": "#contact"
     },
     {
      "slug": "secondary_url",
      "label": "Second button link",
      "type": "string",
      "validation": {
       "pattern": "^(?:$|(?:https?://|mailto:|tel:|/(?!/)|#).+)$"
      }
     },
     {
      "slug": "anchor_id",
      "label": "Menu link name (optional). Lowercase, e.g. faq. A menu item linking to #faq jumps here.",
      "type": "string",
      "validation": {
       "pattern": "^(?:$|[a-z][a-z0-9_-]*)$"
      }
     }
    ]
   }
  ]
 },
